---
import { type BlogPostWithExcerpt } from '../utils/type'
import getPostMetadata from '../utils/postMetadata';
import Tags from './Tags.astro';
import DateBadge from './DateBadge.astro';

interface Props {
  post: BlogPostWithExcerpt
}

const { post } = Astro.props;
const { slug, title, tags, date } = getPostMetadata(post);
const { excerpt } = post;
---
<article class="blog-post-item marker-trigger">
  <div class="meta">
    <DateBadge date={date} />
    {tags.length > 0 && (
      <Tags tagsArr={tags} isLink={true} class="card-tags" />
    )}
  </div>
  <h3 class="marker"><a href={`/blog/${slug}/`} class="title-link">{title}</a></h3>
  {excerpt && (
    <p class="excerpt">{excerpt}</p>
  )}
</article>

<style>
  .blog-post-item {
    display: flex;
    flex-direction: column;
    gap: .25rem;
    position: relative;
    padding: 1rem;
    isolation: isolate;
    color: var(--text);
    text-decoration: none;
    opacity: 0;
    transform: translateX(-5px);
    transition: all .6s ease-in-out;
  }
  .blog-post-item::before {
    content: '';
    position: absolute;
    inset: 0;
    z-index: -1;
    background: rgb(from var(--bg-mild) r g b / 0.5);
    backdrop-filter: blur(1px);
  }

  .blog-post-item.is-visible {
    opacity: 1;
    transform: translateX(0);
  }

  @media (prefers-reduced-motion: reduce) {
    .blog-post-item {
      opacity: 1;
      transform: none;
      animation: none;
    }
  }

  .blog-post-item h3 {
    color: var(--text);
    text-decoration: none;
  }

  .title-link {
    color: inherit;
    text-decoration: none;
  }
  .title-link::after {
    content: '';
    position: absolute;
    inset: 0;
  }

  .meta {
    display: flex;
    flex-direction: row;
    align-items: center;
    gap: 1rem;
    width: 100%;
    padding: 1px;
    font-size: 0.9rem;
    text-wrap: nowrap;
    overflow-x: auto;
    scrollbar-width: none;
    -ms-overflow-style: none;
    &::-webkit-scrollbar {
      display: none;
    }
  }

  .card-tags {
    position: relative;
    z-index: 1; /* .title-link::after より前 */
  }

  .excerpt {
    display: -webkit-box;
    -webkit-box-orient: vertical;
    -webkit-line-clamp: 2;
    overflow: hidden;
    opacity: .7;
  }
</style>

<script>
  import { observeVisibility } from '../utils/observer';
  observeVisibility('.blog-post-item', { once: true });
</script>