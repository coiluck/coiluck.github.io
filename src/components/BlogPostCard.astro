---
const { slug, title, tags, date, excerpt } = Astro.props;
---

<a href={`/blog/${slug}/`} class="blog-post-item">
  <time class="date">{date}</time>
  <div class="meta">
    {tags.length > 0 && (
      <div class="tags">
        {tags.map((tag: string) => (
          <span
            class="post-tag"
            onclick={`event.preventDefault(); window.location.href='/blog/tag/${encodeURIComponent(tag)}/'`}
            role="link"
            tabindex="0"
          >
            {tag}
          </span>
        ))}
      </div>
    )}
  </div>
  <h3>{title}</h3>
  {excerpt && (
    <p class="excerpt">{excerpt}</p>
  )}
</a>

<style>
  .blog-post-item {
    --cut: 3rem;
    --out: 1rem; /* 日付がカードの左からはみ出す幅 */
    display: flex;
    flex-direction: column;
    gap: .25rem;
    position: relative;
    width: 100%;
    padding: 3rem 1rem 1rem;
    isolation: isolate;
    color: var(--text);
    text-decoration: none;
    opacity: 0;
    transform: translateX(-5px);
    transition: all .6s ease-in-out;
  }
  .blog-post-item::before {
    content: '';
    position: absolute;
    inset: 0;
    z-index: -1;
    background: rgb(from var(--bg-mild) r g b / 0.5);
    backdrop-filter: blur(1px);
    clip-path: polygon(
      0% 0%,
      100% 0%,
      100% calc(100% - var(--cut)),  /* 右下カット */
      calc(100% - var(--cut)) 100%,
      0% 100%,
      0% var(--cut)
    );
  }

  .blog-post-item.is-visible {
    opacity: 1;
    transform: translateX(0);
  }

  @media (prefers-reduced-motion: reduce) {
    .blog-post-item {
      opacity: 1;
      transform: none;
      animation: none;
    }
  }

  .blog-post-item h3 {
    width: fit-content;
    color: var(--text);
    text-decoration: none;
    background: linear-gradient(currentcolor, currentcolor) left bottom / 100% 2px no-repeat,
      linear-gradient(#f6d893, #f6d893) right 60% / 0 .8em no-repeat;
    transition: background-size .4s;
  }
  .blog-post-item:hover h3 {
    background-position: right bottom, left 60%;
    background-size: 0 2px, 100% .8em;
  }
  :root[data-theme="dark"] .blog-post-item h3 {
    background: linear-gradient(currentcolor, currentcolor) left bottom / 100% 2px no-repeat,
      linear-gradient(#6088C6, #6088C6) right 60% / 0 .8em no-repeat;
  }
  :root[data-theme="dark"] .blog-post-item:hover h3 {
    background-position: right bottom, left 60%;
    background-size: 0 2px, 100% .8em;
  }

  .meta {
    display: flex;
    flex-direction: row;
    align-items: flex-end;
    gap: 1rem;
    width: 100%;
    padding: 1px;
    text-wrap: nowrap;
    color: rgb(from var(--text) r g b / .5);
    overflow-x: auto;
    scrollbar-width: none;
    -ms-overflow-style: none;
    &::-webkit-scrollbar {
      display: none;
    }
  }

  .tags {
    display: flex;
    flex-direction: row;
    justify-content: center;
    gap: 5px;
    font-size: 0.9rem;
  }

  .tags .post-tag {
    position: relative;
    padding: 4px 8px;
    background: rgb(from var(--accent) r g b / 0.1);
    color: var(--text);
    text-decoration: none;
    font-style: italic;
    border: 1px solid var(--accent);
    cursor: pointer;
    transition: all 0.3s ease;
  }
  .tags .post-tag::before {
    content: '#';
    color: var(--accent);
  }
  .tags .post-tag:after {
    content: '';
    position: absolute;
    bottom: 0;
    left: 0;
    width: 100%;
    height: 0%;
    background: rgb(from var(--accent) r g b / 0.1);
    transition: all 0.3s ease;
  }
  .tags .post-tag:hover {
    background: rgb(from var(--accent) r g b / 0.2);
  }
  .tags .post-tag:hover::after {
    height: 100%;
  }

  .date {
    position: absolute;
    top: .4rem;
    left: calc(-1 * var(--out));
    z-index: 0;
    padding: .5rem 1.5rem .5rem 1rem;
    font-size: .9rem;
    line-height: 1;
    color: var(--text-dark);
  }
  .date::before,
  .date::after {
    content: '';
    position: absolute;
    inset: 0;
    z-index: -1;
    clip-path: polygon(0 0, 100% 0, 100% calc(100% - 8px), calc(100% - 8px) 100%, 0 100%);
  }
  .date::before {
    background: rgb(from var(--text) r g b / .3);
    transform: translate(5px, 5px);
  }
  .date::after {
    background: var(--accent);
  }

  .excerpt {
    display: -webkit-box;
    -webkit-box-orient: vertical;
    -webkit-line-clamp: 2;
    overflow: hidden;
    opacity: .7;
  }
</style>

<script>
  import { observeVisibility } from '../utils/observer';
  observeVisibility('.blog-post-item', { once: true });
</script>