---
interface Props {
  date: string;
}

const { date } = Astro.props;
---
<time class="date">{date}</time>

<style>
  /* 親が position: relative と --out（左にはみ出す幅）を持つ前提 */
  .date {
    position: absolute;
    top: .4rem;
    left: calc(-1 * var(--out));
    z-index: 0;
    padding: .5rem 1.5rem .5rem 1rem;
    font-size: .9rem;
    line-height: 1;
    color: var(--text-dark);
  }
  .date::before,
  .date::after {
    content: '';
    position: absolute;
    inset: 0;
    z-index: -1;
    clip-path: polygon(0 0, 100% 0, 100% calc(100% - 8px), calc(100% - 8px) 100%, 0 100%);
  }
  .date::before {
    background: rgb(from var(--text) r g b / .3);
    transform: translate(5px, 5px);
  }
  .date::after {
    background: var(--accent);
  }
</style>
