---
interface Props {
  pcSize: number; // 90 -> 90%
  smSize: number;
  isNeedMargin?: boolean
  side?: 'left' | 'right'; // スラッシュを置く側
}

const { pcSize, smSize, isNeedMargin, side = 'left' } = Astro.props;
---
<div
  class:list={['blog-line', { 'is-right': side === 'right' }]}
  style={`--pc-size: ${pcSize}%; --sm-size: ${smSize}%; --margin: ${isNeedMargin ? '30px' : '0'}`}
  aria-hidden="true"
>
  <span class="slashes"><i></i><i></i><i></i></span>
</div>

<style>
  .blog-line {
    display: flex;
    align-items: center;
    gap: .8rem;
    width: var(--pc-size);
    margin: var(--margin) auto;
  }
  .blog-line.is-right {
    flex-direction: row-reverse;
  }
  @media (max-width: 768px) {
    .blog-line {
      width: var(--sm-size);
    }
  }

  /* 線 */
  .blog-line::after {
    content: '';
    flex: 1;
    height: 1px;
    background-color: rgb(from var(--text) r g b / .7);
    transform: scaleX(0);
    transform-origin: left;
    transition: transform .9s .25s;
  }
  .blog-line.is-right::after {
    transform-origin: right;
  }
  .blog-line.is-visible::after {
    transform: scaleX(1);
  }

  /* スラッシュ */
  .slashes {
    display: flex;
    gap: 4px;
  }
  .is-right .slashes {
    flex-direction: row-reverse;
  }
  .slashes i {
    width: 3px;
    height: 1.2rem;
    background-color: var(--accent);
    transform: translateY(6px) skewX(-25deg);
    opacity: 0;
    transition: opacity .3s, transform .3s;
  }
  .is-visible .slashes i {
    opacity: 1;
    transform: skewX(-25deg);
  }
  .is-visible .slashes i:nth-child(2) {
    opacity: .6;
    transition-delay: .08s;
  }
  .is-visible .slashes i:nth-child(3) {
    opacity: .3;
    transition-delay: .16s;
  }

  @media (prefers-reduced-motion: reduce) {
    .blog-line::after,
    .slashes i {
      transition: none;
    }
  }
</style>

<script>
  import { observeVisibility } from '../utils/observer';
  observeVisibility('.blog-line', { once: false });
</script>
