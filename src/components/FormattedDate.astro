---
interface Props {
  date: string;
}

const { date } = Astro.props;

const display = new Date(date).toLocaleDateString('en-US', {
  month: 'short',
  day: 'numeric',
  year: 'numeric',
  timeZone: 'UTC'
})
---
<time class="date" datetime={date}>{display}</time>

<style>
  .date {
    font-size: .9rem;
    line-height: 1;
    color: var(--fg-4);
  }
</style>
