---
import Code from './Code.astro';

const contactCode = `const MY_DOMAIN = 'coiluck.moe';
const MY_MAIL = 'hi' + '@' + MY_DOMAIN;
`;
---
<div class="footer-container">
  <div class="footer-content">
    <a href="/rss.xml" class="footer-item">RSS</a>
    <span> / </span>
    <a href="/sitemap.xml" class="footer-item">Sitemap</a>
    <span> / </span>
    <button type="button" class="footer-others footer-item" id="footer-others-btn" popovertarget="others-menu">Others</button>
  </div>
  <div>Powered by Astro</div>
</div>

<div id="others-menu" class="others-menu" role="menu" popover>
  <button type="button" class="others-menu-item" id="contact-menu-item">Contact</button>
  <a href="/" class="others-menu-item">工事予定地</a>
  <button type="button" class="others-menu-item" id="summon-menu-item">召喚</button>
</div>

<!-- Contact modal -->
<dialog id="contact-modal" class="contact-modal" aria-labelledby="contact-modal-title">
  <div class="contact-modal-panel">
    <div class="contact-modal-header">
      <p id="contact-modal-title" class="contact-modal-title">Contact</p>
      <form method="dialog">
        <button class="contact-modal-close" aria-label="Close">×</button>
      </form>
    </div>
    <div class="contact-modal-body">
      <Code code={contactCode} lang="ts" />
    </div>
  </div>
</dialog>

<style>
  .footer-container {
    position: relative;
    left: 50%;
    transform: translateX(-50%);
    width: 100%;
    padding: 1rem;
    background-color: rgb(from var(--bg-mild) r g b / 0.5);
    border-radius: 50% 50% 10% 10% / 30px 30px 0 0;
    text-align: center;
    font-size: .8em;
  }
  .footer-container .footer-item {
    position: relative;
    padding-left: .8rem;
    color: var(--text);
    text-decoration: none;
    cursor: pointer;
    background: none;
    border: none;
    font: inherit;
  }
  .footer-container .footer-item::before {
    content: '#';
    position: absolute;
    top: 50%;
    left: 0;
    transform: translateY(-50%);
    color: var(--accent);
  }
  .footer-container .footer-item::after {
    content: '';
    position: absolute;
    top: 100%;
    left: 0;
    width: 0;
    height: 1px;
    background-color: var(--text);
    transition: all .3s ease;
  }
  @media (hover: hover) {
    .footer-container .footer-item:hover::after {
      width: 100%;
    }
  }

  .footer-content {
    display: flex;
    flex-direction: row;
    justify-content: center;
    align-items: center;
    gap: clamp(1rem, calc(4 * 1vw + 0rem), 2rem);
  }

  /* Others popup menu */
  .others-menu {
    flex-direction: column;
    gap: .6rem;
    position: fixed;
    margin: 0;
    overflow: visible;
    min-width: 120px;
    padding: 0.5rem;
    background-color: rgb(from var(--bg-mild) r g b / 0.8);
    border: 1px solid var(--fg-1);
    border-radius: .5rem;
    opacity: 0;
    transform: translateY(4px);
    transition:
      opacity 0.15s ease,
      transform 0.15s ease,
      display 0.15s allow-discrete,
      overlay 0.15s allow-discrete;
  }
  .others-menu:popover-open {
    display: flex;
    opacity: 1;
    transform: translateY(0);
  }
  @starting-style {
    .others-menu:popover-open {
      opacity: 0;
      transform: translateY(4px);
    }
  }
  /* 吹き出しの下向き三角 */
  .others-menu::after {
    content: '';
    position: absolute;
    top: 100%;
    left: 50%;
    transform: translateX(-50%);
    border: 6px solid transparent;
    border-top-color: var(--bg-mild);
  }
  .others-menu-item {
    display: block;
    position: relative;
    width: 100%;
    padding: 0.5rem 1rem;
    color: var(--text);
    text-align: left;
    text-decoration: none;
    font-size: 0.8rem;
    font-family: inherit;
    line-height: inherit;
    background: none;
    border: none;
    border-radius: .4rem;
    cursor: pointer;
    transition: all 0.3s ease;
  }
  .others-menu-item:not(:last-child)::after {
    content: '';
    position: absolute;
    top: calc(100% + .3rem); /* others-menu のgap / 2 */
    left: 0;
    width: 100%;
    height: .5px;
    background-color: var(--text);
  }
  @media (hover: hover) {
    .others-menu-item:hover {
      background-color: var(--fg-1);
    }
  }

  /* Contact modal */
  .contact-modal {
    width: min(92vw, 560px);
    max-height: 80vh;
    margin: auto;
    overflow: auto;
    color: var(--text);
    background-color: var(--bg-mild);
    border: 1px solid var(--fg-1);
    border-radius: .75rem;
    opacity: 0;
    transform: translateY(8px);
    transition:
      opacity 0.2s ease,
      transform 0.2s ease,
      display 0.2s allow-discrete,
      overlay 0.2s allow-discrete;
  }
  .contact-modal[open] {
    opacity: 1;
    transform: translateY(0);
  }
  @starting-style {
    .contact-modal[open] {
      opacity: 0;
      transform: translateY(8px);
    }
  }
  .contact-modal::backdrop {
    background-color: rgb(from var(--bg) r g b / 0.5);
    backdrop-filter: blur(2px);
    opacity: 0;
    transition:
      opacity 0.2s ease,
      display 0.2s allow-discrete,
      overlay 0.2s allow-discrete;
  }
  .contact-modal[open]::backdrop {
    opacity: 1;
  }
  @starting-style {
    .contact-modal[open]::backdrop {
      opacity: 0;
    }
  }
  .contact-modal-panel {
    padding: 1rem;
  }
  .contact-modal-header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    margin-bottom: .75rem;
  }
  .contact-modal-title {
    margin: 0;
    font-size: 1rem;
    color: var(--text);
  }
  .contact-modal-close {
    background: none;
    border: none;
    color: var(--text);
    font-size: 1.5rem;
    line-height: 1;
    cursor: pointer;
    padding: .5rem;
    padding-top: .25rem;
    border-radius: .25rem;
    transition: background-color 0.2s ease;
  }
  @media (hover: hover) {
    .contact-modal-close:hover {
      background-color: var(--fg-1);
    }
  }
</style>

<script>
  declare global {
    interface Window {
      summonLive2D?: () => void;
    }
  }

  const MARGIN = 8; // ボタンとメニューの間の余白 (px)

  const btn = document.getElementById('footer-others-btn') as HTMLElement | null;
  const menu = document.getElementById('others-menu') as HTMLElement | null;
  const contactBtn = document.getElementById('contact-menu-item') as HTMLElement | null;
  const summonBtn = document.getElementById('summon-menu-item') as HTMLElement | null;
  const modal = document.getElementById('contact-modal') as HTMLDialogElement | null;

  if (btn && menu) {
    function calcPosition() {
      if (!btn || !menu) return;
      const btnRect = btn.getBoundingClientRect();
      const menuRect = menu.getBoundingClientRect();

      // 左右: ボタン中央に合わせ、画面端からはみ出さないようにクランプ
      const idealLeft = btnRect.left + btnRect.width / 2 - menuRect.width / 2;
      const clampedLeft = Math.max(8, Math.min(idealLeft, window.innerWidth - menuRect.width - 8));

      // 上: 常にボタンの上
      const top = btnRect.top - menuRect.height - MARGIN;

      menu.style.left = `${clampedLeft}px`;
      menu.style.top = `${top}px`;
    }

    menu.addEventListener('toggle', (e) => {
      if ((e as ToggleEvent).newState === 'open') calcPosition();
    });

    window.addEventListener('resize', () => { if (menu.matches(':popover-open')) calcPosition(); });
    window.addEventListener('scroll', () => { if (menu.matches(':popover-open')) calcPosition(); });
  }

  // Contact
  if (contactBtn && modal) {
    contactBtn.addEventListener('click', () => {
      menu?.hidePopover();
      modal.showModal();
    });

    // 背景クリックで閉じる
    modal.addEventListener('click', (e) => {
      if (e.target === modal) modal.close();
    });
  }

  // Live2Dを出現
  summonBtn?.addEventListener('click', () => {
    menu?.hidePopover();
    window.summonLive2D?.();
  });
</script>
