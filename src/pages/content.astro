---
import Layout from '../layouts/Layout.astro';
import Topbar from '../components/Topbar.astro';
import Footer from '../components/Footer.astro';
import BlogLine from '../components/BlogLine.astro';
import { Image } from 'astro:assets';
import createImage from '../assets/images/create.avif';

import { getCollection } from 'astro:content';
const allCreates = await getCollection('creates');

const sortedCreates = allCreates.sort((a, b) => {
  const dateA = a.data.published_date.getTime();
  const dateB = b.data.published_date.getTime();
  return dateB - dateA;
});

const groups = new Map<number, typeof sortedCreates>();
for (const create of sortedCreates) {
  const year = create.data.published_date.getUTCFullYear();
  groups.set(year, [...(groups.get(year) ?? []), create]);
}
const createsByYear = [...groups];
---
<Layout pageTitle="Content" ogDescription="制作物の一覧">
  <Topbar />

  <div class="image-container">
    <Image src={createImage} alt="" />
  </div>

  <main class="content">
    <div class="creates-inner">
      <header class="creates-header">
        <h1 class="creates-title">制作物</h1>
        <p class="creates-sub">つくったものなど</p>
      </header>

      {createsByYear.map(([year, creates]) => (
        <section>
          <div class="year-label">
            <h2 class="year-number">{year}</h2>
            <div class="year-line">
              <BlogLine pcSize={100} smSize={100} />
            </div>
          </div>
          <ol class="timeline">
            {creates.map((create) => (
              <li>
                <a class="timeline-item marker-trigger" href={create.data.url} target="_blank" rel="noopener noreferrer">
                  <time class="timeline-date">
                    {(create.data.published_date).toLocaleDateString('en-US', {
                      month: 'short',
                      day: 'numeric'
                    })}
                  </time>
                  <span class="timeline-title marker">{create.data.title}</span>
                  {create.data.tags.length > 0 && (
                    <div class="tags">
                      {create.data.tags.map((tag) => (
                        <span class="post-tag">{tag}</span>
                      ))}
                    </div>
                  )}
                  <span class="timeline-description">{create.data.description}</span>
                </a>
              </li>
            ))}
          </ol>
        </section>
      ))}
    </div>

    <Footer />
  </main>
  <style>
    .image-container {
      position: fixed;
      left: 0;
      right: 0;
      bottom: 0;
      width: 100%;
      height: 100%;
      pointer-events: none;
      z-index: 1;
    }
    .image-container img {
      display: block;
      position: absolute;
      right: 0;
      bottom: 0;
      max-width: 100%;
      height: auto;
      max-height: 80%;
      object-fit: contain;
      object-position: bottom right;
      animation: fadeIn .5s ease-in;
    }
    @keyframes fadeIn {
      from { opacity: 0; }
      to { opacity: 1; }
    }

    .content {
      display: flex;
      flex-direction: column;
      gap: 3rem;
      position: relative;
      height: 100dvh;
      padding-top: 8rem;
      z-index: 2;
      overflow-y: auto;
      scrollbar-width: none;
      &::-webkit-scrollbar {
        display: none;
      }
    }
    @media (max-width: 768px) {
      .content {
        padding-top: 6rem;
      }
    }
    .creates-inner {
      width: 70%;
      margin: 0 auto;
    }
    @media (max-width: 768px) {
      .creates-inner {
        width: 90%;
      }
    }

    .creates-title {
      margin: .3rem 0 .2rem;
      font-size: 1.5rem;
      line-height: 1.4;
    }
    .creates-sub {
      font-size: .9rem;
      opacity: .7;
    }

    .year-label {
      display: flex;
      align-items: center;
      gap: 1rem;
      margin: 2.2rem 0 .6rem;
    }
    .year-number {
      padding: .15rem 1.3rem;
      color: var(--text-dark);
      background-color: var(--accent);
      font-size: 1.1rem;
      font-weight: normal;
      clip-path: polygon(12% 0, 100% 0, 88% 100%, 0 100%);
    }
    .year-line {
      flex: 1;
    }

    .timeline {
      display: flex;
      flex-direction: column;
      gap: .5rem;
      position: relative;
      padding-left: 2rem;
      list-style: none;
    }
    .timeline::before {
      content: '';
      position: absolute;
      bottom: 0;
      left: 1rem;
      width: 1px;
      height: calc(100% - 1rem);
      background: var(--accent);
    }
    .timeline-item {
      --cut: 1rem;
      display: grid;
      grid-template-columns: 3.2rem 1fr auto;
      align-items: baseline;
      gap: .2rem 1rem;
      padding: .7rem 1rem;
      color: var(--text);
      text-decoration: none;
      backdrop-filter: blur(2px);
      background-color: rgb(from var(--bg-mild) r g b / .5);
      transition: all .3s;
    }
    .timeline-date {
      font-size: .85rem;
      opacity: .7;
    }
    .timeline-title {
      font-size: 1.1rem;
    }
    .timeline-description {
      grid-column: 2;
      font-size: .85rem;
      line-height: 1;
      opacity: .7;
    }
    @media (hover: hover) {
      .timeline-item:hover {
        background-color: rgb(from var(--bg-mild) r g b / .7);
      }
    }

    .tags {
      display: flex;
      flex-wrap: wrap;
      justify-content: flex-end;
      align-self: center;
      grid-column: 3;
      grid-row: 1 / span 2;
      gap: 5px;
      font-size: .8rem;
    }
    .post-tag {
      padding: 2px 7px;
      background: rgb(from var(--accent) r g b / 0.1);
      color: var(--text);
      font-style: italic;
      border: 1px solid var(--accent);
    }
    .post-tag::before {
      content: '#';
      color: var(--accent);
    }

    @media (max-width: 768px) {
      .timeline-item {
        grid-template-columns: 1fr;
      }
      .timeline-description, .tags {
        grid-column: 1;
        grid-row: auto;
        justify-content: flex-start;
        margin-top: .2rem;
      }
    }
  </style>
</Layout>
