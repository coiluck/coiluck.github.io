---
import type { GetStaticPathsOptions, Page } from 'astro';
import { getSortedPosts, getListedPosts, POSTS_PER_PAGE } from '../../utils/getPosts';
import { addExcerpts } from '../../utils/generateExcerpt';
import type { BlogPostWithExcerpt } from '../../utils/type';
import Layout from '../../layouts/Layout.astro';
import Topbar from '../../components/Topbar.astro';
import BlogImage from '../../components/BlogImage.astro';
import BlogLine from '../../components/BlogLine.astro';
import Search from '../../components/Search.astro';
import BlogPostCard from '../../components/BlogPostCard.astro';
import Pagination from '../../components/Pagination.astro';
import Footer from '../../components/Footer.astro';

export async function getStaticPaths({ paginate }: GetStaticPathsOptions) {
  const allSortedPosts = await getSortedPosts();
  const listedPosts = addExcerpts(getListedPosts(allSortedPosts));

  const paginatedResult = paginate(listedPosts, { pageSize: POSTS_PER_PAGE });
  return paginatedResult;
}

interface Props {
  page: Page<BlogPostWithExcerpt>;
}
const { page } = Astro.props;

// OGP用
const ogDescription = "書く、これしか出来ないから";
---
<Layout
  pageTitle="Blog"
  ogDescription={ogDescription}
  isBlog
>
  <Topbar />

  <div class="blog-header">
    <BlogImage />
    <Search />
  </div>

  <main>
    <div class="blog-content">
      {page.data.length > 0 ? (
        page.data.map((post) => <BlogPostCard post={post} />)
      ) : (
        <div style="text-align: center; padding: 2rem;">
          <p>現在、表示できる投稿がありません</p>
        </div>
      )}
    </div>

    <BlogLine
      pcSize={70}
      smSize={90}
      isNeedMargin={false}
    />

    <Pagination page={page} />
  </main>

  <Footer />
</Layout>

<style>
  .blog-header {
    padding-top: 8rem;
  }
  @media (max-width: 768px) {
    .blog-header {
      padding-top: 6rem;
    }
  }
  main {
    display: flex;
    flex-direction: column;
    gap: 2rem;
  }
  .blog-content {
    display: flex;
    flex-direction: column;
    gap: 2rem;
    margin: 0 auto;
    width: 70%;
  }
  @media (max-width: 768px) {
    .blog-content {
      width: 90%;
    }
  }
</style>