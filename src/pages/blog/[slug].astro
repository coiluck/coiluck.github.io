---
import { render } from 'astro:content';
import { getSortedPosts } from '../../utils/getPosts';
import getPostMetadata from '../../utils/postMetadata';
import { generateExcerpt } from '../../utils/generateExcerpt';
import Layout from '../../layouts/Layout.astro';
import Topbar from '../../components/Topbar.astro';
import BlogImage from '../../components/BlogImage.astro';
import BlogLine from '../../components/BlogLine.astro';
import Footer from '../../components/Footer.astro';
import TopButton from '../../components/TopButton.astro';
import '../../styles/link-card.css';
import '../../styles/article.css';

export async function getStaticPaths() {
  const posts = await getSortedPosts();

  return posts.map((post) => {
    const { slug } = getPostMetadata(post);

    return {
      params: { slug },
      props: { post },
    };
  });
}

// 記事データ用
const { post } = Astro.props;
const isUnlisted = post.data.status === 'unlisted';

const {title, date, tags } = getPostMetadata(post);

const { Content } = await render(post);

const ogDescription = generateExcerpt(post, 30);

const markdown = post.body ?? '';
---
<Layout
  pageTitle={title}
  ogDescription={ogDescription}
  isBlog
  noindex={isUnlisted}
>
  <Topbar />

  <div class="blog-header">
    <BlogImage />
  </div>

  <article
    class="blog-post"
    data-pagefind-body={isUnlisted ? undefined : true}
    data-pagefind-meta={isUnlisted ? undefined : `date:${date}`}
    data-pagefind-sort={isUnlisted ? undefined : `date:${date}`}
  >
    <header class="post-head">
      <time class="date">{date}</time>
      <h1 class="post-title">{title}</h1>
      <div class="post-sub">
        <div class="tags">
          {tags.length > 0 && (
            tags.map((tag) => (
              <a class="post-tag" href={`/blog/tag/${encodeURIComponent(tag)}/`}>
                <span data-pagefind-filter="tag">{tag}</span>
              </a>
            ))
          )}
        </div>
        <button id="copy" class="copy-md" data-markdown={markdown} title="Copy as Markdown">
          <svg class="copy-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <rect x="9" y="9" width="13" height="13" rx="2" />
            <path d="M5 15H4a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2h9a2 2 0 0 1 2 2v1" />
          </svg>
          <svg class="check-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <path d="M20 6 9 17l-5-5" />
          </svg>
          <span class="copy-label" aria-live="polite">.md</span>
        </button>
      </div>
    </header>

    <BlogLine
      pcSize={100}
      smSize={100}
      isNeedMargin={true}
    />

    <div class="content prose">
      <Content />
    </div>

    <BlogLine
      pcSize={100}
      smSize={100}
      isNeedMargin={true}
      side="right"
    />
  </article>

  <TopButton />

  <div style="height: 60px;"></div>

  <Footer />

  <style>
    .blog-header {
      padding: 8rem 0 0;
    }
    @media (max-width: 768px) {
      .blog-header {
        padding-top: 6rem;
      }
    }
    
    article {
      width: 70%;
      margin: 0 auto;
      background: rgb(from var(--bg) r g b / .3);
      backdrop-filter: blur(1px);
    }
    @media (max-width: 768px) {
      article {
        width: 90%;
      }
    }

    .post-head {
      position: relative;
      padding: 3.6rem 1.5rem 0;
    }
    @media (max-width: 768px) {
      .post-head {
        padding: 3.4rem 1rem 1.5rem;
      }
    }

    .date {
      position: absolute;
      top: .6rem;
      left: -1rem;
      z-index: 0;
      padding: .5rem 1.5rem .5rem 1rem;
      font-size: .9rem;
      line-height: 1;
      color: var(--text-dark);
    }
    @media (max-width: 768px) {
      .date {
        left: -.6rem;
      }
    }
    .date::before,
    .date::after {
      content: '';
      position: absolute;
      inset: 0;
      z-index: -1;
      clip-path: polygon(0 0, 100% 0, 100% calc(100% - 8px), calc(100% - 8px) 100%, 0 100%);
    }
    .date::before {
      background: rgb(from var(--text) r g b / .3);
      transform: translate(5px, 5px);
    }
    .date::after {
      background: var(--accent);
    }

    .post-title {
      width: fit-content;
      margin: .6rem 0;
      font-size: 1.5rem;
      color: var(--text);
    }

    .post-sub {
      display: grid;
      grid-template-columns: 1fr auto;
      align-items: center;
      gap: 1rem;
      width: 100%;
    }
    
    .tags {
      display: flex;
      flex-wrap: wrap;
      gap: 5px;
      font-size: 0.9rem;
    }
    .post-tag {
      position: relative;
      padding: 2px 8px;
      background: rgb(from var(--accent) r g b / 0.1);
      color: var(--text);
      text-decoration: none;
      font-style: italic;
      border: 1px solid var(--accent);
      transition: all 0.3s ease;
    }
    .post-tag::before {
      content: '#';
      color: var(--accent);
    }
    .post-tag::after {
      content: '';
      position: absolute;
      bottom: 0;
      left: 0;
      width: 100%;
      height: 0%;
      background: rgb(from var(--accent) r g b / 0.1);
      transition: all 0.3s ease;
    }
    .post-tag:hover {
      background: rgb(from var(--accent) r g b / 0.2);
    }
    .post-tag:hover::after {
      height: 100%;
    }

    .copy-md {
      position: relative;
      display: inline-flex;
      align-items: center;
      gap: 6px;
      padding: 6px 12px;
      background: var(--bg);
      color: var(--text);
      font-family: "JetBrainsMono", sans-serif;
      font-size: .85rem;
      line-height: 1;
      border: 1px solid var(--text);
      cursor: pointer;
      transition: all 0.3s ease;
    }
    .copy-md::after {
      content: '';
      position: absolute;
      bottom: 0;
      left: 0;
      width: 100%;
      height: 0%;
      background: rgb(from var(--accent) r g b / 0.1);
      transition: all 0.3s ease;
    }
    .copy-md:hover {
      background: rgb(from var(--accent) r g b / 0.2);
    }
    .copy-md:hover::after {
      height: 100%;
    }
    .copy-md svg {
      width: 14px;
      height: 14px;
      color: var(--accent);
    }
    .copy-md .check-icon {
      display: none;
    }
    .copy-md[data-copied] {
      background: var(--accent);
      color: var(--text-dark);
    }
    .copy-md[data-copied] svg {
      color: var(--text-dark);
    }
    .copy-md[data-copied] .copy-icon {
      display: none;
    }
    .copy-md[data-copied] .check-icon {
      display: block;
    }

    .content {
      margin-bottom: 2rem;
    }
  </style>
  <script>
    document.addEventListener('DOMContentLoaded', () => {
      // Tooltipの配置
      const handleTooltipPosition = (el: HTMLElement) => {
        // リセットしてから本来の位置を測定
        el.style.left = '50%';
        el.style.right = '';
        el.style.transform = 'translateX(-50%)';

        const margin = 8; // 画面端から少し空ける
        const rect = el.getBoundingClientRect();
        const viewportWidth = document.documentElement.clientWidth;

        let shift = 0;
        if (rect.right > viewportWidth - margin) {
          shift = (viewportWidth - margin) - rect.right; // 負
        } else if (rect.left < margin) {
          shift = margin - rect.left; // 正
        }

        if (shift !== 0) {
          el.style.transform = `translateX(calc(-50% + ${shift}px))`;
        }
      };

      const allTooltip: NodeListOf<HTMLElement> = document.querySelectorAll('sup .footnote-hover-tooltip');
      const positionAll = () => allTooltip.forEach(handleTooltipPosition);

      positionAll();
      window.addEventListener('resize', positionAll);

      // copy
      const copyBtn = document.getElementById('copy') as HTMLButtonElement | null;
      const copyLabel = copyBtn?.querySelector<HTMLElement>('.copy-label');
      let copiedTimer: number | undefined;
      copyBtn?.addEventListener('click', async () => {
        await navigator.clipboard.writeText(copyBtn.dataset.markdown ?? '');
        copyBtn.dataset.copied = '';
        if (copyLabel) copyLabel.textContent = 'Copied!';
        clearTimeout(copiedTimer);
        copiedTimer = window.setTimeout(() => {
          delete copyBtn.dataset.copied;
          if (copyLabel) copyLabel.textContent = '.md';
        }, 2000);
      });
    });
  </script>
</Layout>