---
import { render } from 'astro:content';
import { getSortedPosts } from '../../utils/getPosts';
import getPostMetadata from '../../utils/postMetadata';
import { generateExcerpt } from '../../utils/generateExcerpt';
import Layout from '../../layouts/Layout.astro';
import Topbar from '../../components/Topbar.astro';
import BlogImage from '../../components/BlogImage.astro';
import BlogLine from '../../components/BlogLine.astro';
import Footer from '../../components/Footer.astro';
import TopButton from '../../components/TopButton.astro';
import '../../styles/link-card.css';
import '../../styles/article.css';

export async function getStaticPaths() {
  const posts = await getSortedPosts();

  return posts.map((post) => {
    const { slug } = getPostMetadata(post);

    return {
      params: { slug },
      props: { post },
    };
  });
}

// 記事データ用
const { post } = Astro.props;
const isUnlisted = post.data.status === 'unlisted';

const {title, date, tags } = getPostMetadata(post);

const { Content } = await render(post);

const ogDescription = generateExcerpt(post, 30);
---
<Layout
  pageTitle={title}
  ogDescription={ogDescription}
  isBlog
  noindex={isUnlisted}
>
  <Topbar />
  <div class="blog-header">
    <BlogImage />
  </div>
  <article
    class="blog-post"
    data-pagefind-body={isUnlisted ? undefined : true}
    data-pagefind-meta={isUnlisted ? undefined : `date:${date}`}
    data-pagefind-sort={isUnlisted ? undefined : `date:${date}`}
  >
    <h2>{title}</h2>
    <div class="meta">
      <p>投稿日: {date}</p>
      <p>
        タグ:
        {tags.map((tag, tagIndex) => (
          <span>
            <a href={`/blog/tag/${encodeURIComponent(tag)}/`}>
              <span style="color: var(--accent);">#</span>
              <span data-pagefind-filter="tag">{tag}</span>
            </a>
            {tagIndex < tags.length - 1 && ', '}
          </span>
        ))}
      </p>
    </div>

    <BlogLine
      pcSize={100}
      smSize={100}
      isNeedMargin={true}
    />

    <div class="content prose">
      <Content />
    </div>
  </article>

  <BlogLine
    pcSize={70}
    smSize={90}
    isNeedMargin={true}
  />

  <TopButton />

  <div style="height: 60px;"></div>

  <Footer />

  <style>
    .blog-header {
      padding: 8rem 0 0;
    }
    @media (max-width: 768px) {
      .blog-header {
        padding-top: 6rem;
      }
    }
    .blog-post {
      width: 70%;
      margin: 0 auto;
      background-color: rgb(from var(--bg) r g b / .5);
      backdrop-filter: blur(1px);
    }
    @media (max-width: 768px) {
      .blog-post {
        width: 90%;
      }
    }
    .blog-post > h2 {
      margin: .5rem 0 0;
      color: var(--text);
      text-align: center;
    }
    .meta {
      font-size: 0.9rem;
      text-align: center;
      color: rgb(from var(--text) r g b / .5);
    }
    .meta p {
      margin: .5rem 0 0;
    }
    .meta p span a {
      position: relative;
      color: rgb(from var(--text) r g b / .5);
      text-decoration: none;
      transition: all 0.3s ease;
    }
    .meta p span a::before {
      content: '';
      position: absolute;
      bottom: 0;
      left: 0;
      width: 0;
      height: 2px;
      background-color: rgb(from var(--text) r g b / .5);
      transform: scaleY(0.5);
      transform-origin: bottom;
      transition: width 0.3s ease;
    }
    .meta p span a:hover::before {
      width: 100%;
    }

    .content {
      margin-bottom: 2rem;
    }
  </style>
  <script>
    document.addEventListener('DOMContentLoaded', () => {
      // Tooltipの配置
      const handleTooltipPosition = (el: HTMLElement) => {
        // リセットしてから本来の位置を測定
        el.style.left = '50%';
        el.style.right = '';
        el.style.transform = 'translateX(-50%)';

        const margin = 8; // 画面端から少し空ける
        const rect = el.getBoundingClientRect();
        const viewportWidth = document.documentElement.clientWidth;

        let shift = 0;
        if (rect.right > viewportWidth - margin) {
          shift = (viewportWidth - margin) - rect.right; // 負
        } else if (rect.left < margin) {
          shift = margin - rect.left; // 正
        }

        if (shift !== 0) {
          el.style.transform = `translateX(calc(-50% + ${shift}px))`;
        }
      };

      const allTooltip: NodeListOf<HTMLElement> = document.querySelectorAll('sup .footnote-hover-tooltip');
      const positionAll = () => allTooltip.forEach(handleTooltipPosition);

      positionAll();
      window.addEventListener('resize', positionAll);
    });
  </script>
</Layout>